{
  "name": "halsa",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve backoffice",
    "start:mock": "ng serve backoffice --configuration mock",
    "start:portal": "ng serve portal",
    "start:portal:mock": "ng serve portal --configuration mock",
    "build": "ng build backoffice && ng build portal && node scripts/check-bundles.mjs",
    "build:backoffice": "ng build backoffice",
    "build:portal": "ng build portal",
    "test": "node scripts/check-contrast.mjs && ng test backoffice --watch=false && ng test portal --watch=false",
    "test:backoffice": "ng test backoffice --watch=false",
    "test:portal": "ng test portal --watch=false",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "e2e:theme": "playwright test -c playwright.keycloak.config.ts",
    "api:types": "openapi-typescript http://localhost:5600/openapi/v1.json -o libs/api-types/src/schema.d.ts",
    "api:types:yaml": "openapi-typescript ../Halsa.Backend/docs/api/atel-api.openapi.yaml -o libs/api-types/src/schema.d.ts",
    "kc:sync": "node scripts/sync-realms.mjs",
    "kc:up": "npm run theme:css && podman compose -f dev/keycloak/compose.yaml up -d && node scripts/wait-keycloak.mjs",
    "kc:down": "podman compose -f dev/keycloak/compose.yaml down",
    "kc:reset": "npm run kc:down && npm run kc:up",
    "kc:logs": "podman compose -f dev/keycloak/compose.yaml logs -f keycloak",
    "theme:css": "tailwindcss -i keycloak-theme/src/halsa.css -o keycloak-theme/themes/halsa/login/resources/css/halsa.css --minify && node scripts/copy-fonts.mjs",
    "theme:watch": "tailwindcss -i keycloak-theme/src/halsa.css -o keycloak-theme/themes/halsa/login/resources/css/halsa.css --watch",
    "theme:build": "npm run theme:css && node scripts/build-theme-jar.mjs",
    "check:contrast": "node scripts/check-contrast.mjs"
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@ng-icons/core": "^34.0.0",
    "@ng-icons/lucide": "^34.0.0",
    "@spartan-ng/brain": "^1.8.0",
    "angular-auth-oidc-client": "^21.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ngx-scrollbar": "^19.1.5",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.7.0",
    "tslib": "^2.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.27",
    "@angular/cli": "^21.2.9",
    "@angular/compiler-cli": "^21.2.0",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@spartan-ng/cli": "^1.8.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "angular-eslint": "^21.4.0",
    "eslint": "^10.13.0",
    "fflate": "^0.8.3",
    "jsdom": "^28.0.0",
    "openapi-typescript": "^7.13.0",
    "otplib": "^13.5.0",
    "postcss": "^8.5.30",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.0.8"
  }
}

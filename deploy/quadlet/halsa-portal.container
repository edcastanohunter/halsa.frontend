# Quadlet del portal de pacientes. Mismo esquema que halsa-backoffice.container (runbook §4.4).
[Unit]
Description=Halsa portal de pacientes (nginx + SPA)
After=halsa-borde-network.service

[Container]
ContainerName=halsa-portal
NetworkAlias=halsa-portal
Image=localhost/halsa-portal:${HALSA_FRONT_TAG}
Pull=never
Network=halsa-borde.network
ReadOnly=true
Tmpfs=/tmp
Tmpfs=/etc/nginx/conf.d
DropCapability=ALL
NoNewPrivileges=true
LogDriver=journald
Notify=healthy
HealthCmd=wget -q -O /dev/null http://127.0.0.1:8080/health
HealthInterval=15s
HealthTimeout=3s
HealthRetries=3
HealthStartPeriod=10s

[Service]
EnvironmentFile=%h/.config/halsa-frontend/frontend.env
Restart=always
RestartSec=10
TimeoutStartSec=120

[Install]
WantedBy=default.target

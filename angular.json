{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "backoffice": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/backoffice",
      "sourceRoot": "projects/backoffice/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/backoffice/src/main.ts",
            "tsConfig": "projects/backoffice/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/backoffice/public",
                "ignore": ["config.mock.json"]
              },
              {
                "glob": "theme-init.js",
                "input": "libs/ui/src/assets",
                "output": "/"
              }
            ],
            "styles": ["projects/backoffice/src/styles.css"],
            "define": {
              "HALSA_CONFIG_URL": "\"/config.json\""
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "750kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "sourceMap": {
                "scripts": true,
                "styles": true,
                "hidden": true
              },
              "fileReplacements": [
                {
                  "replace": "projects/backoffice/src/app/dev.routes.ts",
                  "with": "projects/backoffice/src/app/dev.routes.prod.ts"
                },
                {
                  "replace": "projects/backoffice/src/app/dev.interceptors.ts",
                  "with": "projects/backoffice/src/app/dev.interceptors.prod.ts"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "mock": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "assets": [
                {
                  "glob": "**/*",
                  "input": "projects/backoffice/public"
                },
                {
                  "glob": "theme-init.js",
                  "input": "libs/ui/src/assets",
                  "output": "/"
                }
              ],
              "define": {
                "HALSA_CONFIG_URL": "\"/config.mock.json\""
              }
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 3000,
            "proxyConfig": "proxy.backoffice.json",
            "headers": {
              "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' http://localhost:5600 http://localhost:8080 http://localhost:8180; frame-src http://localhost:8080 http://localhost:8180; frame-ancestors 'none'; base-uri 'self'; form-action 'self' http://localhost:8080 http://localhost:8180; object-src 'none'; require-trusted-types-for 'script'; trusted-types angular angular#bundler halsa#iconos",
              "Referrer-Policy": "no-referrer",
              "X-Content-Type-Options": "nosniff",
              "Cross-Origin-Opener-Policy": "same-origin-allow-popups",
              "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
            }
          },
          "configurations": {
            "production": {
              "buildTarget": "backoffice:build:production"
            },
            "development": {
              "buildTarget": "backoffice:build:development"
            },
            "mock": {
              "buildTarget": "backoffice:build:mock"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "include": ["**/*.spec.ts", "../../../libs/**/*.spec.ts"]
          }
        }
      }
    },
    "portal": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/portal",
      "sourceRoot": "projects/portal/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/portal/src/main.ts",
            "tsConfig": "projects/portal/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/portal/public",
                "ignore": ["config.mock.json"]
              },
              {
                "glob": "theme-init.js",
                "input": "libs/ui/src/assets",
                "output": "/"
              }
            ],
            "styles": ["projects/portal/src/styles.css"],
            "define": {
              "HALSA_CONFIG_URL": "\"/config.json\""
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "600kB",
                  "maximumError": "800kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "sourceMap": {
                "scripts": true,
                "styles": true,
                "hidden": true
              },
              "fileReplacements": [
                {
                  "replace": "projects/portal/src/app/dev.routes.ts",
                  "with": "projects/portal/src/app/dev.routes.prod.ts"
                },
                {
                  "replace": "projects/portal/src/app/dev.interceptors.ts",
                  "with": "projects/portal/src/app/dev.interceptors.prod.ts"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "mock": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "assets": [
                {
                  "glob": "**/*",
                  "input": "projects/portal/public"
                },
                {
                  "glob": "theme-init.js",
                  "input": "libs/ui/src/assets",
                  "output": "/"
                }
              ],
              "define": {
                "HALSA_CONFIG_URL": "\"/config.mock.json\""
              }
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 4300,
            "ssl": true,
            "proxyConfig": "proxy.portal.json",
            "headers": {
              "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; require-trusted-types-for 'script'; trusted-types angular angular#bundler halsa#iconos",
              "Referrer-Policy": "no-referrer",
              "X-Content-Type-Options": "nosniff",
              "Cross-Origin-Opener-Policy": "same-origin-allow-popups",
              "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
            }
          },
          "configurations": {
            "production": {
              "buildTarget": "portal:build:production"
            },
            "development": {
              "buildTarget": "portal:build:development"
            },
            "mock": {
              "buildTarget": "portal:build:mock"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
